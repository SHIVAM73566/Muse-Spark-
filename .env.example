# Public Supabase configuration used by the app for sign-in and database access.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Preferred key name for Supabase publishable keys.
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
# Legacy anon key variable remains supported by src/lib/supabase.ts.
EXPO_PUBLIC_SUPABASE_KEY=YOUR_SUPABASE_ANON_OR_PUBLISHABLE_KEY

# Server-side local Expo API routes. Never prefix secret values with EXPO_PUBLIC_.
OPENAI_API_KEY=
OPENAI_AGENT_MODEL=gpt-5.2
OPENAI_SCHEDULE_MODEL=
COMPOSIO_API_KEY=
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=

# Optional server-side Supabase values. SUPABASE_SERVICE_ROLE_KEY bypasses RLS;
# keep it private and use it only in trusted server-side code.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional API origin for native builds that use a separately hosted API.
EXPO_PUBLIC_API_URL=
